# Backend configuration — the canonical reference for every env var the
# Phiacta Python backend consumes.
#
# Copy to .env for standalone dev (running uvicorn directly). The dev
# Docker Compose stack (phiacta-deploy-repo/docker-compose.yml) hardcodes
# these with safe dev defaults, so no .env is needed when running via
# Compose. For prod, run phiacta-deploy-repo/generate-env.sh prod to
# generate a .env.prod with random secrets.
#
# Stack-level vars (paths, host ports, browser URLs) live separately in
# phiacta-deploy-repo/.env.example.

# Docker Compose — resolve docker/docker-compose.yml from the repo root
COMPOSE_FILE=docker/docker-compose.yml

# ── Required ───────────────────────────────────────────────────
# Async Postgres URL. Dev uses the Docker Compose Postgres on port 5433.
DATABASE_URL=postgresql+asyncpg://phiacta:devpassword@localhost:5433/phiacta

# JWT signing key — MUST be ≥32 characters. App fails to start otherwise.
# Generate a strong prod value with: openssl rand -base64 48 | tr -d '\n/+='
JWT_SECRET_KEY=dev-only-change-me-in-production-32chars!

# ── Optional ───────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=debug
LOG_FORMAT=console
CORS_ORIGINS=[]
DATABASE_POOL_SIZE=20

# ── Forgejo (git backend) ──────────────────────────────────────
# URL the backend uses to reach Forgejo. In Docker Compose this is
# http://forgejo:3000 (service name); on the host it's http://localhost:3002.
FORGEJO_URL=http://localhost:3000

# Forgejo admin credentials — used only to bootstrap the admin user on
# first boot of the Forgejo container (see docker/forgejo-entrypoint.sh).
# Safe default exists; override for prod.
FORGEJO_ADMIN_USER=phiacta-admin
FORGEJO_ADMIN_PASSWORD=phiacta-dev-password

# Org under which entry repos are created.
FORGEJO_ORG=phiacta

# HMAC-SHA256 shared secret used to verify incoming Forgejo webhooks.
# Must match the secret configured on each Forgejo webhook. If unset,
# ALL webhooks are silently rejected — push ingestion stops working.
FORGEJO_WEBHOOK_SECRET=dev-webhook-secret
